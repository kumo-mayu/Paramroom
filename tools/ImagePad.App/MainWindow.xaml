<Window x:Class="ImagePad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ImagePad.App.ViewModels"
        Title="ImagePad 送信" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        Background="#F4F5F7" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        FontFamily="Yu Gothic UI" FontSize="13">
    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="BorderBrush" Value="#E1E4E8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#57606A" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="PreviewFrame" TargetType="Border">
            <Setter Property="Background" Value="#2B2F36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 送信先 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="送信先" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox DockPanel.Dock="Left" Width="420" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                          DisplayMemberPath="Label" AutomationProperties.Name="送信先" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Left" Content="探し直す" Command="{Binding RefreshTargetsCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TargetText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#57606A" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. 送る画像 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="1. 送る画像" />
                    <StackPanel DockPanel.Dock="Top">
                        <Button Content="ファイルから選ぶ…" Command="{Binding ChooseFileCommand}" HorizontalAlignment="Left" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="画像の URL" MinHeight="30">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoadUrlCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="URL から読み込む" Command="{Binding LoadUrlCommand}" Margin="6,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource Note}" Text="ファイルのドラッグや、画像・URL の貼り付け（Ctrl+V）でも指定できます。" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton Content="画像全体を送る" IsChecked="{Binding FitStretch}" GroupName="fit" Margin="0,0,16,0" />
                            <RadioButton Content="中央を正方形に切り抜く" IsChecked="{Binding FitCrop}" GroupName="fit" />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource PreviewFrame}" Margin="0,10,0,0">
                        <Grid>
                            <Image Source="{Binding SourceImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="まだ画像がありません" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SourceImage, Converter={x:Static vm:Converters.NullToVisible}}" />
                            <TextBlock Text="読み込み中…" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 2. 変換 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="2. 全部届いたときの見え方" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,8"
                               Text="アバターの表示板に出る絵です。図形の集まりに変換するので、元の画像より粗くなります。" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <ProgressBar Height="6" Maximum="1" Value="{Binding EncodeProgress, Mode=OneWay}" Visibility="{Binding IsEncoding, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding EncodeText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource PreviewFrame}">
                        <Grid>
                            <Image Source="{Binding EncodedImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <TextBlock Text="変換が終わるとここに出ます" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding EncodedImage, Converter={x:Static vm:Converters.NullToVisible}}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 3. 送信 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="3. 送信" />
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="送り方" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding SelectedSchedule}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="送り方" IsEnabled="{Binding IsSending, Mode=OneWay, Converter={x:Static vm:Converters.Not}}" />
                        <TextBlock Style="{StaticResource Note}" Text="{Binding SelectedSchedule.Description}" />
                        <TextBlock Text="送信の間隔（送信中も変えられます）" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding HoldOptions}" SelectedItem="{Binding SelectedHold}" DisplayMemberPath="Label" AutomationProperties.Name="送信の間隔" />
                        <TextBlock Style="{StaticResource Note}" Text="{Binding SelectedHold.Description}" />
                        <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}" Margin="0,12,0,0" MinHeight="40" FontSize="15" FontWeight="SemiBold" />
                        <ProgressBar Height="6" Maximum="1" Value="{Binding SendProgress, Mode=OneWay}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SendText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Heading}" Text="受け取った人の見え方" Margin="0,16,0,0" FontSize="14" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8" Text="送信を始めたときから見ている人の場合（パケットの取りこぼしは考えていません）。" />
                    </StackPanel>
                    <Border Style="{StaticResource PreviewFrame}">
                        <Grid>
                            <Image Source="{Binding ReceivedImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <TextBlock Text="送信を始めると、届いていく様子がここに出ます" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ReceivedImage, Converter={x:Static vm:Converters.NullToVisible}}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- メッセージ -->
        <Border Grid.Row="2" Background="#FFF4E5" BorderBrush="#F0B35B" BorderThickness="1" CornerRadius="6" Margin="8,0,8,4" Padding="12,8"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.Name="お知らせ" />
        </Border>
    </Grid>
</Window>
