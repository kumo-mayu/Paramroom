<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI に依存しない本体（エンコーダー・送信・送信先の検出・コマンドと状態）。
    画面（ImagePad.App）とコマンドライン（ImagePadTool）とテストが同じものを使うので、WPF を持ち込まない
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- エンコーダーは最適化しないと数倍遅い（512/4000 が Debug で約 10 秒）。画面の確かめは Debug で起動するので常に最適化する -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImagePad.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="VRChat.OSCQuery" Version="0.0.7" />
  </ItemGroup>

</Project>
