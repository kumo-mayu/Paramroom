# dependencies / caches
node_modules/
sim/cache/
# 1024 reference images (41 MB, rebuilt with: node sim/prepare.js 1024)
sim/images/ref1024/
sim/images/ref1024-train/
# per-image caches from the precision study (regenerable with sim/precision-eval.js)
sim/results/precision/
sim/results/precision-eval.log
# large regenerable simulation outputs (raw rows are hundreds of MB; summaries are kept)
sim/results/*.jsonl
sim/out/
# unity temp
measure/unity/**/Library/
measure/unity/**/Temp/
*.tmp*
measure/analysis/synthetic/
# .NET build output
tools/**/bin/
tools/**/obj/
# primitive runs of the local-transfer codec study (regenerable with sim/local/prim-cs.js)
sim/local/results/prim-tmp/
